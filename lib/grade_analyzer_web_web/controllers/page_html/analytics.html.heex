<div class="min-h-screen bg-slate-50 text-slate-800">
  <div class="flex min-h-screen">
    <aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white p-6 md:block">
      <div class="mb-10">
        <h1 class="text-2xl font-bold tracking-tight text-indigo-700">GradeWise</h1>
      </div>
      
      <nav class="space-y-2">
        <a
          href="/"
          class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-600 hover:bg-slate-100"
        >
          <span>▦</span> Dashboard
        </a>
        
        <a
          href="/students"
          class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-600 hover:bg-slate-100"
        >
          <span>♙</span> Students
        </a>
        
        <a
          href="/analytics"
          class="flex items-center gap-3 rounded-xl bg-indigo-50 px-4 py-3 font-semibold text-indigo-700"
        >
          <span>▥</span> Analytics
        </a>
      </nav>
    </aside>
    
    <main class="min-w-0 flex-1 p-5 sm:p-8">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Analytics</h2>
        
        <a
          href="/"
          class="rounded-xl border border-slate-200 bg-white px-5 py-3 font-semibold text-slate-700 hover:bg-slate-100"
        >
          ← Dashboard
        </a>
      </div>
      
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-sm font-semibold text-slate-600">Class Average</h3>
          
          <p class="mt-3 text-3xl font-bold text-indigo-600">{@class_average}%</p>
        </div>
        
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-sm font-semibold text-slate-600">Highest Scorer</h3>
          
          <%= if @highest_student do %>
            <p class="mt-3 text-2xl font-bold text-slate-900">{@highest_student.name}</p>
            
            <p class="mt-1 text-sm text-slate-500">{@highest_student.marks} marks</p>
          <% else %>
            <p class="mt-3 text-2xl font-bold text-slate-900">—</p>
            
            <p class="mt-1 text-sm text-slate-500">No students yet</p>
          <% end %>
        </div>
        
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-sm font-semibold text-slate-600">Lowest Scorer</h3>
          
          <%= if @lowest_student do %>
            <p class="mt-3 text-2xl font-bold text-slate-900">{@lowest_student.name}</p>
            
            <p class="mt-1 text-sm text-slate-500">{@lowest_student.marks} marks</p>
          <% else %>
            <p class="mt-3 text-2xl font-bold text-slate-900">—</p>
            
            <p class="mt-1 text-sm text-slate-500">No students yet</p>
          <% end %>
        </div>
        
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-sm font-semibold text-slate-600">Pass Rate</h3>
          
          <p class="mt-3 text-3xl font-bold text-emerald-600">{@pass_rate}%</p>
        </div>
      </div>
      
      <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="mb-6 text-lg font-bold text-slate-900">Grade Distribution</h3>
        
        <div class="space-y-6">
          <div>
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-semibold text-slate-700">Grade A</span>
              <span class="font-medium text-slate-700">{@grade_counts.a} students</span>
            </div>
            
            <div class="h-3 w-full rounded-full bg-slate-100">
              <div
                class="h-3 rounded-full bg-emerald-500"
                style={"width: #{@grade_percentages.a}%"}
              >
              </div>
            </div>
          </div>
          
          <div>
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-semibold text-slate-700">Grade B</span>
              <span class="font-medium text-slate-700">{@grade_counts.b} students</span>
            </div>
            
            <div class="h-3 w-full rounded-full bg-slate-100">
              <div
                class="h-3 rounded-full bg-indigo-500"
                style={"width: #{@grade_percentages.b}%"}
              >
              </div>
            </div>
          </div>
          
          <div>
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-semibold text-slate-700">Grade C</span>
              <span class="font-medium text-slate-700">{@grade_counts.c} students</span>
            </div>
            
            <div class="h-3 w-full rounded-full bg-slate-100">
              <div class="h-3 rounded-full bg-sky-500" style={"width: #{@grade_percentages.c}%"}>
              </div>
            </div>
          </div>
          
          <div>
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-semibold text-slate-700">Grade D</span>
              <span class="font-medium text-slate-700">{@grade_counts.d} students</span>
            </div>
            
            <div class="h-3 w-full rounded-full bg-slate-100">
              <div class="h-3 rounded-full bg-amber-500" style={"width: #{@grade_percentages.d}%"}>
              </div>
            </div>
          </div>
          
          <div>
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-semibold text-slate-700">Grade F</span>
              <span class="font-medium text-slate-700">{@grade_counts.f} students</span>
            </div>
            
            <div class="h-3 w-full rounded-full bg-slate-100">
              <div class="h-3 rounded-full bg-rose-500" style={"width: #{@grade_percentages.f}%"}>
              </div>
            </div>
          </div>
        </div>
        
        <%= if @total_students == 0 do %>
          <p class="mt-6 text-sm text-slate-500">
            No student data is available yet. Add students to see analytics.
          </p>
        <% end %>
      </section>
    </main>
  </div>
</div>
