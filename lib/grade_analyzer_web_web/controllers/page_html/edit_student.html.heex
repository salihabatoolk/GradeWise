<div class="min-h-screen bg-slate-50 p-5 text-slate-800 sm:p-8">
  <div class="mx-auto max-w-2xl">
    <a href="/students" class="mb-6 inline-block text-sm font-semibold text-indigo-700 hover:underline">← Back to Students</a>

<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h1 class="mb-6 text-3xl font-bold tracking-tight text-slate-900">Edit Student</h1>

  <form action={"/students/#{@student.id}/update"} method="post" class="space-y-5">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

    <div>
      <label for="student_name" class="mb-2 block text-sm font-semibold text-slate-700">Student Name</label>
      <input id="student_name" type="text" name="student[name]" value={@student.name} required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-indigo-500 focus:outline-none" />
    </div>

    <div>
      <label for="student_marks" class="mb-2 block text-sm font-semibold text-slate-700">Marks (1–100)</label>
      <input id="student_marks" type="text" inputmode="numeric" pattern="[0-9]{1,3}" name="student[marks]" value={to_string(@student.marks)} required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-indigo-500 focus:outline-none" />
    </div>

    <div class="flex flex-wrap gap-3">
      <button type="submit" class="rounded-xl bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700">Save Changes</button>
      <a href="/students" class="rounded-xl border border-slate-200 px-6 py-3 font-semibold text-slate-700 hover:bg-slate-100">Cancel</a>
    </div>
  </form>
</section>

  </div>
</div>
