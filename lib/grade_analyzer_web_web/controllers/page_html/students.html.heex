<div class="min-h-screen bg-slate-50 text-slate-800">
  <div class="flex min-h-screen">
    <aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white p-6 md:block">
      <h1 class="mb-10 text-2xl font-bold tracking-tight text-indigo-700">GradeWise</h1>
      
      <nav class="space-y-2">
        <a href="/" class="block rounded-xl px-4 py-3 text-slate-600 hover:bg-slate-100">Dashboard</a>
        <a
          href="/students"
          class="block rounded-xl bg-indigo-50 px-4 py-3 font-semibold text-indigo-700"
        >Students</a>
        <a href="/analytics" class="block rounded-xl px-4 py-3 text-slate-600 hover:bg-slate-100">Analytics</a>
      </nav>
    </aside>
    
    <main class="min-w-0 flex-1 p-5 sm:p-8">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Students</h2>
        
        <a
          href="/"
          class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100"
        >Dashboard</a>
      </div>
      
      <%= if Phoenix.Flash.get(@flash, :info) do %>
        <p class="mb-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-700">
          {Phoenix.Flash.get(@flash, :info)}
        </p>
      <% end %>
      
      <%= if Phoenix.Flash.get(@flash, :error) do %>
        <p class="mb-4 rounded-xl bg-rose-50 p-3 text-sm text-rose-700">
          {Phoenix.Flash.get(@flash, :error)}
        </p>
      <% end %>
      
      <section class="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="mb-5 text-lg font-bold text-slate-900">Add Student</h3>
        
        <form action="/students" method="post" class="space-y-5">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <div>
            <label for="student_name" class="mb-2 block text-sm font-semibold text-slate-700">Student Name</label>
            <input
              id="student_name"
              type="text"
              name="student[name]"
              placeholder="Enter student name"
              required
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none"
            />
          </div>
          
          <div>
            <label for="student_marks" class="mb-2 block text-sm font-semibold text-slate-700">Marks (1–100)</label>
            <input
              id="student_marks"
              type="number"
              min="1"
              max="100"
              step="1"
              name="student[marks]"
              placeholder="Enter marks from 1 to 100"
              required
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none"
            />
          </div>
          
          <button
            type="submit"
            class="rounded-xl bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700"
          >Add Student</button>
        </form>
      </section>
      
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="mb-5 text-lg font-bold text-slate-900">Student Records</h3>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-slate-600">
                <th class="px-4 py-3 font-semibold">#</th>
                
                <th class="px-4 py-3 font-semibold">Student Name</th>
                
                <th class="px-4 py-3 font-semibold">Marks</th>
                
                <th class="px-4 py-3 font-semibold">Grade</th>
                
                <th class="px-4 py-3 font-semibold">Actions</th>
              </tr>
            </thead>
            
            <tbody>
              <%= if @students == [] do %>
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-slate-500">
                    No students added yet.
                  </td>
                </tr>
              <% else %>
                <%= for {student, index} <- Enum.with_index(@students, 1) do %>
                  <tr class="border-b border-slate-100 last:border-0">
                    <td class="px-4 py-4 text-slate-500">{index}</td>
                    
                    <td class="px-4 py-4 font-medium text-slate-800">{student.name}</td>
                    
                    <td class="px-4 py-4 font-semibold text-slate-800">{student.marks}</td>
                    
                    <td class="px-4 py-4 font-bold text-indigo-700">
                      <%= cond do %>
                        <% student.marks >= 80 -> %>
                          A
                        <% student.marks >= 70 -> %>
                          B
                        <% student.marks >= 60 -> %>
                          C
                        <% student.marks >= 50 -> %>
                          D
                        <% true -> %>
                          F
                      <% end %>
                    </td>
                    
                    <td class="px-4 py-4">
                      <div class="flex flex-wrap gap-2">
                        <a
                          href={"/students/#{student.id}/edit"}
                          class="rounded-lg bg-indigo-50 px-3 py-2 font-semibold text-indigo-700 hover:bg-indigo-100"
                        >Edit</a>
                        <form
                          action={"/students/#{student.id}/delete"}
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this student?');"
                        >
                          <input
                            type="hidden"
                            name="_csrf_token"
                            value={Plug.CSRFProtection.get_csrf_token()}
                          />
                          <button
                            type="submit"
                            class="rounded-lg bg-rose-50 px-3 py-2 font-semibold text-rose-700 hover:bg-rose-100"
                          >Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</div>
