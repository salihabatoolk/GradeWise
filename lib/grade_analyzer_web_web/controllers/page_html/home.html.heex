<div class="min-h-screen bg-slate-50 text-slate-800">
  <div class="flex min-h-screen">
    <aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white p-6 md:block">
      <div class="mb-10">
        <h1 class="text-2xl font-bold tracking-tight text-indigo-700">GradeWise</h1>
      </div>
      
      <nav class="space-y-2">
        <a
          href="/"
          class="flex items-center gap-3 rounded-xl bg-indigo-50 px-4 py-3 font-semibold text-indigo-700"
        >
          <span>▦</span> Dashboard
        </a>
        
        <a
          href="/students"
          class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-600 hover:bg-slate-100"
        >
          <span>♙</span> Students
        </a>
        
        <a
          href="/analytics"
          class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-600 hover:bg-slate-100"
        >
          <span>▥</span> Analytics
        </a>
      </nav>
    </aside>
    
    <main class="min-w-0 flex-1 p-5 sm:p-8">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900">Dashboard</h2>
        </div>
      </div>
      
      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Total Students</p>
          
          <p class="mt-3 text-3xl font-bold text-slate-900">{@total_students}</p>
        </div>
        
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Class Average</p>
          
          <p class="mt-3 text-3xl font-bold text-indigo-600">{@class_average}%</p>
        </div>
        
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Passed</p>
          
          <p class="mt-3 text-3xl font-bold text-emerald-600">{@passed}</p>
        </div>
        
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Failed</p>
          
          <p class="mt-3 text-3xl font-bold text-rose-600">{@failed}</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm xl:col-span-2">
          <div class="flex items-center justify-between border-b border-slate-100 p-6">
            <h3 class="text-lg font-bold text-slate-900">Student Performance</h3>
            
            <a
              href="/students"
              class="text-sm font-semibold text-indigo-600 hover:text-indigo-800"
            >View all</a>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th class="px-6 py-4 font-semibold">Student</th>
                  
                  <th class="px-6 py-4 font-semibold">Marks</th>
                  
                  <th class="px-6 py-4 font-semibold">Grade</th>
                  
                  <th class="px-6 py-4 font-semibold">Status</th>
                </tr>
              </thead>
              
              <tbody class="divide-y divide-slate-100">
                <%= for student <- @students do %>
                  <tr>
                    <td class="px-6 py-4 font-medium text-slate-800">{student.name}</td>
                    
                    <td class="px-6 py-4">{student.marks}</td>
                    
                    <td class="px-6 py-4">
                      <span class={
                        if student.marks >= 80 do
                          "rounded-lg bg-emerald-50 px-3 py-1 font-semibold text-emerald-700"
                        else
                          if student.marks >= 70 do
                            "rounded-lg bg-indigo-50 px-3 py-1 font-semibold text-indigo-700"
                          else
                            if student.marks >= 60 do
                              "rounded-lg bg-sky-50 px-3 py-1 font-semibold text-sky-700"
                            else
                              if student.marks >= 50 do
                                "rounded-lg bg-amber-50 px-3 py-1 font-semibold text-amber-700"
                              else
                                "rounded-lg bg-rose-50 px-3 py-1 font-semibold text-rose-700"
                              end
                            end
                          end
                        end
                      }>
                        <%= cond do %>
                          <% student.marks >= 80 -> %>
                            A
                          <% student.marks >= 70 -> %>
                            B
                          <% student.marks >= 60 -> %>
                            C
                          <% student.marks >= 50 -> %>
                            D
                          <% true -> %>
                            F
                        <% end %>
                      </span>
                    </td>
                    
                    <td class="px-6 py-4 font-medium">
                      <%= if student.marks >= 50 do %>
                        <span class="text-emerald-600">✓ Passed</span>
                      <% else %>
                        <span class="text-rose-600">✗ Failed</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
                
                <%= if @students == [] do %>
                  <tr>
                    <td colspan="4" class="px-6 py-8 text-center text-slate-500">
                      No students added yet. Add a student from the Students page.
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
        
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900">Grade Distribution</h3>
          
          <div class="mt-7 space-y-5">
            <div>
              <div class="mb-2 flex justify-between text-sm">
                <span class="font-medium">Grade A</span>
                <span class="text-slate-500">{@grade_counts.a} students</span>
              </div>
              
              <div class="h-2.5 rounded-full bg-slate-100">
                <div
                  class="h-2.5 rounded-full bg-emerald-500"
                  style={"width: #{@grade_percentages.a}%"}
                >
                </div>
              </div>
            </div>
            
            <div>
              <div class="mb-2 flex justify-between text-sm">
                <span class="font-medium">Grade B</span>
                <span class="text-slate-500">{@grade_counts.b} students</span>
              </div>
              
              <div class="h-2.5 rounded-full bg-slate-100">
                <div
                  class="h-2.5 rounded-full bg-indigo-500"
                  style={"width: #{@grade_percentages.b}%"}
                >
                </div>
              </div>
            </div>
            
            <div>
              <div class="mb-2 flex justify-between text-sm">
                <span class="font-medium">Grade C</span>
                <span class="text-slate-500">{@grade_counts.c} students</span>
              </div>
              
              <div class="h-2.5 rounded-full bg-slate-100">
                <div
                  class="h-2.5 rounded-full bg-sky-500"
                  style={"width: #{@grade_percentages.c}%"}
                >
                </div>
              </div>
            </div>
            
            <div>
              <div class="mb-2 flex justify-between text-sm">
                <span class="font-medium">Grade D</span>
                <span class="text-slate-500">{@grade_counts.d} students</span>
              </div>
              
              <div class="h-2.5 rounded-full bg-slate-100">
                <div
                  class="h-2.5 rounded-full bg-amber-500"
                  style={"width: #{@grade_percentages.d}%"}
                >
                </div>
              </div>
            </div>
            
            <div>
              <div class="mb-2 flex justify-between text-sm">
                <span class="font-medium">Grade F</span>
                <span class="text-slate-500">{@grade_counts.f} students</span>
              </div>
              
              <div class="h-2.5 rounded-full bg-slate-100">
                <div
                  class="h-2.5 rounded-full bg-rose-500"
                  style={"width: #{@grade_percentages.f}%"}
                >
                </div>
              </div>
            </div>
          </div>
          
          <a
            href="/analytics"
            class="mt-8 block rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50"
          >
            View Analytics
          </a>
        </section>
      </div>
    </main>
  </div>
</div>
